# Публичный сайт: админка сюда не проксируется вовсе (защита в дополнение к 404 в приложении).
# Домены задаются в .env; значения по умолчанию — служебные .localhost, чтобы при
# незаполненном .env Caddy подписал их внутренним сертификатом и не ходил в Let's Encrypt.
{$SITE_DOMAIN:site.localhost} {
	encode zstd gzip

	@admin path /admin /admin/*
	respond @admin 404

	# Собранные файлы Astro: имя содержит хеш содержимого, новая сборка даёт
	# новое имя — такие можно кешировать навсегда.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Остальная статика имя не меняет: кешируем на сутки, чтобы правка
	# доезжала до посетителей без ручной чистки кеша.
	@static path /icons/* /favicon.svg /avatar.svg /webmcp.js
	header @static Cache-Control "public, max-age=86400"

	reverse_proxy site-app:4321
}

# Отдельный поддомен для админки (Basic Auth проверяет само приложение)
{$ADMIN_DOMAIN:admin.localhost} {
	encode zstd gzip
	reverse_proxy site-app:4321
}

# Дополнительные домены сайта (через пробел, например «example.ru www.example.com»).
# Caddy выпустит на каждый свой сертификат Let's Encrypt и отдаст 301 на канонический
# SITE_DOMAIN — так у страниц остаётся один адрес для поиска и ссылок.
# Значение по умолчанию — служебный .localhost: Caddy подписывает такие имена
# внутренним сертификатом и в Let's Encrypt не ходит, поэтому пустой
# ALIAS_DOMAINS ничего не ломает.
{$ALIAS_DOMAINS:alias.localhost} {
	redir https://{$SITE_DOMAIN:site.localhost}{uri} permanent
}

# Свои блоки (другие приложения на этом же сервере) — в ./deploy/local/*.caddy.
# Каталог не в git, поэтому `git pull` не конфликтует с локальными правками;
# если файлов нет, import по маске просто ничего не делает.
import /etc/caddy/local/*.caddy
