---
import { DEFAULT_LANG, type Lang } from '../lib/i18n';
import { t } from '../lib/i18n/dict';

/**
 * Виджет «сейчас играет».
 *
 * Раньше это был островок Svelte с `client:load`: ради одного опроса раз в
 * 20 секунд на каждую загрузку главной приезжал рантайм Svelte (~60 КБ).
 * Разметка и так рендерится на сервере, а обновлять её — работа на десяток
 * строк, поэтому здесь обычный HTML и маленький скрипт без зависимостей.
 */
interface Track {
  title: string;
  artist: string;
  coverUrl: string;
  url: string;
  progressMs: number;
  durationMs: number;
}
interface NowPlaying {
  configured: boolean;
  playing: boolean;
  track: Track | null;
}

interface Props {
  initial: NowPlaying;
  lang?: Lang;
}

const { initial, lang = DEFAULT_LANG } = Astro.props;
const track = initial.track;
const progress =
  track && track.durationMs > 0 ? Math.min(100, (track.progressMs / track.durationMs) * 100) : 0;
const showBar = initial.playing && !!track && track.durationMs > 0;
---

{
  track && (
    <section
      class:list={['spotify', { playing: initial.playing }]}
      id="spotify-widget"
      data-now={t(lang, 'spotify.now')}
      data-recent={t(lang, 'spotify.recent')}
    >
      <div class="head">
        <span class="logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.5 17.3a.75.75 0 0 1-1.03.25c-2.83-1.73-6.39-2.12-10.59-1.16a.75.75 0 1 1-.33-1.46c4.56-1.04 8.48-.6 11.7 1.34.35.22.46.68.25 1.03zm1.47-3.27a.94.94 0 0 1-1.29.31c-3.24-1.99-8.18-2.57-12-1.4a.94.94 0 1 1-.55-1.8c4.37-1.32 9.8-.68 13.53 1.6.44.27.58.85.31 1.29zm.13-3.4C15.24 8.32 8.84 8.11 5.13 9.24a1.13 1.13 0 1 1-.65-2.16c4.26-1.29 11.33-1.04 15.8 1.61a1.13 1.13 0 0 1-1.18 1.94z" />
          </svg>
        </span>
        <span class="label" data-sp="label">
          {initial.playing ? t(lang, 'spotify.now') : t(lang, 'spotify.recent')}
        </span>
        <span class="eq" data-sp="eq" aria-hidden="true" hidden={!initial.playing}>
          {[0, 1, 2, 3].map((i) => (
            <span class="eq-bar" style={`animation-duration:${0.7 + i * 0.13}s;animation-delay:${i * 0.1}s`} />
          ))}
        </span>
      </div>
      <a class="track" data-sp="link" href={track.url} target="_blank" rel="noopener noreferrer" data-ripple>
        {track.coverUrl ? (
          <img
            class="cover"
            data-sp="cover"
            src={track.coverUrl}
            alt={t(lang, 'spotify.coverAlt')}
            width="72"
            height="72"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="cover cover-empty" data-sp="cover-empty">
            cover
          </div>
        )}
        <div class="meta">
          <div class="title" data-sp="title">{track.title}</div>
          <div class="artist" data-sp="artist">{track.artist}</div>
        </div>
      </a>
      {/* Полоска прогресса — во всю ширину виджета, под строкой трека */}
      <div
        class="bar"
        data-sp="bar"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={Math.round(progress)}
        hidden={!showBar}
      >
        <div class="fill" data-sp="fill" style={`width:${progress}%`} />
      </div>
    </section>
  )
}

<script>
  /**
   * Опрос /api/now-playing раз в 20 секунд. Работает только пока вкладка
   * активна: в фоне обновлять нечего, а таймер зря будит процессор телефона.
   */
  interface Track {
    title: string;
    artist: string;
    coverUrl: string;
    url: string;
    progressMs: number;
    durationMs: number;
  }
  interface NowPlaying {
    playing: boolean;
    track: Track | null;
  }

  const root = document.getElementById('spotify-widget');
  if (root) {
    const pick = (name: string) => root.querySelector<HTMLElement>(`[data-sp="${name}"]`);
    const label = pick('label');
    const eq = pick('eq');
    const link = pick('link') as HTMLAnchorElement | null;
    const cover = pick('cover') as HTMLImageElement | null;
    const title = pick('title');
    const artist = pick('artist');
    const bar = pick('bar');
    const fill = pick('fill');

    const apply = (data: NowPlaying) => {
      const track = data.track;
      if (!track) return;
      if (label) label.textContent = data.playing ? root.dataset.now ?? '' : root.dataset.recent ?? '';
      if (eq) eq.hidden = !data.playing;
      root.classList.toggle('playing', data.playing);
      if (link && link.href !== track.url) link.href = track.url;
      if (cover && track.coverUrl && cover.src !== track.coverUrl) cover.src = track.coverUrl;
      if (title && title.textContent !== track.title) title.textContent = track.title;
      if (artist && artist.textContent !== track.artist) artist.textContent = track.artist;

      const show = data.playing && track.durationMs > 0;
      if (bar) bar.hidden = !show;
      if (show && fill) {
        const percent = Math.min(100, (track.progressMs / track.durationMs) * 100);
        fill.style.width = `${percent}%`;
        bar?.setAttribute('aria-valuenow', String(Math.round(percent)));
      }
    };

    let timer = 0;
    const tick = async () => {
      try {
        const res = await fetch('/api/now-playing');
        if (res.ok) apply((await res.json()) as NowPlaying);
      } catch {
        /* сеть моргнула — оставляем прошлые данные */
      }
    };
    const start = () => {
      if (timer) return;
      timer = window.setInterval(tick, 20_000);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    if (!document.hidden) start();
  }
</script>

<style>
  .spotify {
    flex: 1 1 300px;
    min-width: min(280px, 100%);
    border-radius: 28px;
    padding: clamp(18px, 4vw, 24px);
    background: linear-gradient(145deg, var(--spotify-tint), var(--glass-05));
    border: 1px solid var(--line-14);
    backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
    box-shadow: var(--shadow-md);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .logo {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--spotify);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--green);
    letter-spacing: 0.4px;
  }
  .eq {
    display: flex;
    gap: 2.5px;
    align-items: flex-end;
    height: 14px;
    margin-left: auto;
  }
  .eq[hidden] {
    display: none;
  }
  .eq-bar {
    width: 3px;
    height: 14px;
    border-radius: 2px;
    background: var(--spotify);
    transform-origin: bottom;
    animation: eq 0.8s ease-in-out infinite;
  }
  .track {
    display: flex;
    gap: 14px;
    align-items: center;
    text-decoration: none;
    border-radius: 16px;
  }
  .cover {
    width: 72px;
    height: 72px;
    flex: none;
    border-radius: 16px;
    object-fit: cover;
    border: 1px solid var(--line-14);
  }
  .cover-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 9px;
    color: var(--fg-55);
    background: repeating-linear-gradient(45deg, var(--glass-08) 0 7px, var(--glass-05) 7px 14px);
  }
  .meta {
    min-width: 0;
  }
  .title {
    font-size: 15.5px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .artist {
    font-size: 13px;
    color: var(--fg-60);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bar {
    margin-top: 16px;
    height: 4px;
    border-radius: 2px;
    background: var(--line-15);
    width: 100%;
    overflow: hidden;
  }
  .bar[hidden] {
    display: none;
  }
  .fill {
    height: 100%;
    border-radius: 2px;
    background: var(--spotify);
    transition: width 0.4s linear;
  }
</style>
