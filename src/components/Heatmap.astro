---
import { formatDate, formatNumber } from '../lib/format';
import { DEFAULT_LANG, type Lang } from '../lib/i18n';
import { t } from '../lib/i18n/dict';

/**
 * Тепловая карта активности: weeks — календарь контрибуций GitHub,
 * claude — карта коммитов с участием Claude (byDate: дата → число).
 */
interface Props {
  total: number;
  weeks: (readonly [string, number])[][];
  claude?: { total: number; byDate: Record<string, number> } | null;
  lang?: Lang;
}

const { total, weeks, claude = null, lang = DEFAULT_LANG } = Astro.props;

function level(count: number): number {
  if (count <= 0) return 0;
  if (count <= 3) return 1;
  if (count <= 7) return 2;
  if (count <= 12) return 3;
  return 4;
}

function claudeLevel(count: number): number {
  if (count <= 0) return 0;
  if (count <= 1) return 1;
  if (count <= 3) return 2;
  if (count <= 6) return 3;
  return 4;
}

const totalLabel = formatNumber(total, lang);
const claudeTotalLabel = claude ? formatNumber(claude.total, lang) : '';
const showToggle = claude !== null;
---

<section class="heatmap glass" data-view="github" id="activity-heatmap">
  <div class="head">
    <h2>
      {t(lang, 'heatmap.title')}
      <span class="sub sub-github">{t(lang, 'heatmap.contributions', { count: totalLabel })}</span>
      <span class="sub sub-claude">{t(lang, 'heatmap.claudeCommits', { count: claudeTotalLabel })}</span>
    </h2>
    {
      showToggle && (
        <div class="views" role="tablist" aria-label={t(lang, 'heatmap.source')}>
          <button class="view active" data-view-btn="github" data-ripple>
            GitHub
          </button>
          <button class="view view-claude" data-view-btn="claude" data-ripple>
            Claude ✨
          </button>
        </div>
      )
    }
  </div>
  <div class="scroll">
    <div class="grid" role="img" aria-label={t(lang, 'heatmap.aria', { count: totalLabel })}>
      {
        weeks.map((week) => (
          <div class="week">
            {week.map(([date, count]) => {
              const claudeCount = claude?.byDate[date] ?? 0;
              const tip =
                `${formatDate(date, lang)} · ${count}` +
                (claudeCount > 0 ? ` · ${t(lang, 'heatmap.withClaude')}: ${claudeCount}` : '');
              return <span class={`cell l${level(count)} c${claudeLevel(claudeCount)}`} title={tip} />;
            })}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.getElementById('activity-heatmap');
    if (!section) return;
    const buttons = section.querySelectorAll('[data-view-btn]');
    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        section.dataset.view = btn.getAttribute('data-view-btn');
        for (const b of buttons) b.classList.toggle('active', b === btn);
      });
    }
  })();
</script>

<style>
  .heatmap {
    border-radius: 28px;
    padding: clamp(18px, 4vw, 28px);
    background: var(--glass-05);
    box-shadow: var(--shadow-md);
    /* Карта — это ~370 ячеек в самом низу страницы: до прокрутки браузер
       не тратит на их разметку и отрисовку ни кадра. */
    content-visibility: auto;
    contain-intrinsic-size: auto 220px;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  h2 {
    margin: 0;
    font-size: 19px;
    font-weight: 700;
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .sub {
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-50);
  }
  .sub-claude,
  [data-view='claude'] .sub-github {
    display: none;
  }
  [data-view='claude'] .sub-claude {
    display: inline;
  }

  .views {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 16px;
    background: var(--glass-07);
    border: 1px solid var(--line-13);
  }
  .view {
    font: inherit;
    color: inherit;
    border: none;
    background: transparent;
    font-size: 12.5px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.25s;
  }
  .view.active {
    background: var(--active);
  }

  .scroll {
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .grid {
    display: flex;
    gap: 3px;
    width: max-content;
  }
  .week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .cell {
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--heat-0);
  }
  .cell.l1 {
    background: var(--heat-1);
  }
  .cell.l2 {
    background: var(--heat-2);
  }
  .cell.l3 {
    background: var(--heat-3);
  }
  .cell.l4 {
    background: var(--heat-4);
  }

  /* Режим Claude: терракотовая шкала по коммитам с Claude */
  [data-view='claude'] .cell {
    background: var(--heat-0);
  }
  [data-view='claude'] .cell.c1 {
    background: var(--claude-1);
  }
  [data-view='claude'] .cell.c2 {
    background: var(--claude-2);
  }
  [data-view='claude'] .cell.c3 {
    background: var(--claude-3);
  }
  [data-view='claude'] .cell.c4 {
    background: var(--claude-4);
  }
</style>
