---
/**
 * Кнопка загрузки с выпадающим списком файлов релиза.
 * Один файл — обычная ссылка, несколько — меню с иконкой платформы,
 * размером и числом загрузок у каждого файла.
 * Файл под ОС посетителя скрипт помечает и поднимает наверх списка.
 */
import PlatformIcon from './PlatformIcon.astro';
import { detectPlatform, formatSize } from '../lib/platform';
import { formatCount } from '../lib/format';

interface AssetLike {
  name: string;
  downloadUrl: string;
  downloadCount: number;
  size: number;
}

interface Props {
  assets: AssetLike[];
  label: string;
  /** accent — крупная кнопка проекта, row — маленькая в списке релизов */
  variant?: 'accent' | 'row';
  /** Куда вести, если файлов нет (страница релиза на GitHub) */
  fallbackUrl?: string;
  fallbackLabel?: string;
}

const { assets, label, variant = 'accent', fallbackUrl = '', fallbackLabel = 'Открыть' } = Astro.props;

const items = assets.map((a) => ({ ...a, platform: detectPlatform(a.name) }));
// .btn-accent — глобальный класс, .rowbtn описан ниже в scoped-стилях
const btnClass = variant === 'accent' ? 'btn-accent' : 'rowbtn';
const single = items.length === 1 ? items[0] : null;
---

{
  items.length === 0 && fallbackUrl && (
    <a class:list={[btnClass, 'flat', variant]} href={fallbackUrl} target="_blank" rel="noopener noreferrer" data-ripple>
      {fallbackLabel} ↗
    </a>
  )
}

{
  single && (
    <a class:list={[btnClass, 'flat', variant]} href={single.downloadUrl} data-ripple title={single.name}>
      <PlatformIcon name={single.platform.id} size={variant === 'accent' ? 18 : 15} />
      {label}
    </a>
  )
}

{
  items.length > 1 && (
    <details class:list={['dl', variant]} data-dl>
      <summary class={btnClass} data-ripple>
        {variant === 'accent' && <span class="dl-glyph">⤓</span>}
        <span class="sum-label">{label}</span>
        <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </summary>
      <div class="menu glass">
        <ul data-dl-list>
          {items.map((a) => (
            <li data-platform={a.platform.id}>
              <a href={a.downloadUrl} data-ripple>
                <span class="ico"><PlatformIcon name={a.platform.id} size={19} /></span>
                <span class="txt">
                  <span class="nm">{a.name}</span>
                  <span class="sub">
                    {a.platform.label}
                    {a.size > 0 && ` · ${formatSize(a.size)}`}
                    {a.downloadCount > 0 && ` · ↓ ${formatCount(a.downloadCount)}`}
                    <span class="mine-badge">для вашей ОС</span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>
  )
}

<style>
  /* Маленькая кнопка в строке релиза (раньше жила в [name].astro как .row-btn) */
  .rowbtn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    padding: 7px 14px;
    border-radius: 14px;
    background: var(--glass-08);
    border: 1px solid var(--line-15);
    color: var(--fg);
    flex: none;
    text-decoration: none;
    transition: background 0.25s;
    position: relative;
    overflow: hidden;
  }
  .rowbtn:hover {
    background: var(--glass-10);
  }
  /* Ссылка без меню (один файл или фолбэк на GitHub) — тот же размер, что у кнопки с меню */
  .flat {
    gap: 8px;
  }
  .flat.accent {
    font-size: clamp(13.5px, 3.8vw, 15px);
    white-space: nowrap;
    flex: none;
    padding: 13px clamp(16px, 4vw, 26px);
    border-radius: 20px;
  }
  .dl {
    position: relative;
    flex: none;
  }
  .dl summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    cursor: pointer;
  }
  .dl summary::-webkit-details-marker {
    display: none;
  }
  .dl.accent summary {
    font-size: clamp(13.5px, 3.8vw, 15px);
    white-space: nowrap;
    padding: 13px clamp(16px, 4vw, 26px);
    border-radius: 20px;
  }
  .dl-glyph {
    font-size: 1.05em;
    line-height: 1;
  }
  .chev {
    transition: transform 0.25s;
    opacity: 0.75;
  }
  .dl[open] .chev {
    transform: rotate(180deg);
  }

  .menu {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    right: 0;
    width: max-content;
    min-width: min(280px, calc(100vw - 40px));
    max-width: min(400px, calc(100vw - 40px));
    border-radius: 20px;
    padding: 6px;
    box-shadow: var(--shadow-md);
    animation: dlIn 0.18s ease-out;
    /* Непрозрачный фон: полупрозрачное меню поверх карточек нечитаемо.
       Слой toast-bg композитится с цветом фона страницы — тема учитывается сама. */
    background: linear-gradient(var(--toast-bg), var(--toast-bg)), var(--bg);
  }
  @keyframes dlIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: min(60vh, 420px);
    overflow-y: auto;
  }
  .menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 15px;
    text-decoration: none;
    color: var(--fg);
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
  }
  .menu a:hover {
    background: var(--glass-10);
  }
  .ico {
    display: flex;
    flex: none;
    color: var(--fg-65);
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .nm {
    font-size: 13.5px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sub {
    font-size: 11.5px;
    color: var(--fg-55);
    white-space: nowrap;
  }
  .mine-badge {
    display: none;
    margin-left: 8px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.2px;
    padding: 2px 7px;
    border-radius: 9px;
    background: var(--badge-admin-bg);
    color: var(--badge-admin-fg);
  }
  li.mine .mine-badge {
    display: inline-block;
  }
  li.mine .ico {
    color: var(--fg);
  }
  li.mine > a {
    background: var(--glass-08);
  }
</style>

<script>
  /** Платформа посетителя — чтобы подсветить подходящий файл. */
  function currentOs(): string {
    const ua = navigator.userAgent;
    const plat = (navigator as any).userAgentData?.platform || navigator.platform || '';
    if (/Android/i.test(ua)) return 'android';
    // iPad с iPadOS 13+ представляется как MacIntel, отличаем по тач-точкам
    if (/iPhone|iPad|iPod/i.test(ua) || (/Mac/i.test(plat) && navigator.maxTouchPoints > 1)) return 'ios';
    if (/Mac/i.test(plat) || /Mac OS X/i.test(ua)) return 'macos';
    if (/Win/i.test(plat) || /Windows/i.test(ua)) return 'windows';
    if (/Linux|X11|CrOS/i.test(plat + ua)) return 'linux';
    return '';
  }

  function markOwnPlatform() {
    const os = currentOs();
    if (!os) return;
    document.querySelectorAll<HTMLUListElement>('[data-dl-list]').forEach((list) => {
      const mine = Array.from(list.children).filter(
        (li) => (li as HTMLElement).dataset.platform === os,
      ) as HTMLLIElement[];
      if (mine.length === 0 || mine.length === list.children.length) return;
      // Свои файлы — наверх списка, в исходном порядке
      mine.reverse().forEach((li) => {
        li.classList.add('mine');
        list.prepend(li);
      });
    });
  }

  function closeAll(except?: Element | null) {
    document.querySelectorAll<HTMLDetailsElement>('details[data-dl][open]').forEach((d) => {
      if (d !== except) d.open = false;
    });
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    // Выбрали файл — меню закрываем, загрузка идёт своим ходом
    if (target?.closest?.('[data-dl] .menu a')) {
      closeAll();
      return;
    }
    closeAll(target?.closest?.('details[data-dl]'));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });

  markOwnPlatform();
</script>
