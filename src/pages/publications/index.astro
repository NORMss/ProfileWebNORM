---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedPosts } from '../../lib/queries';
import { formatDate } from '../../lib/format';
import { localePath } from '../../lib/i18n';
import { t } from '../../lib/i18n/dict';
import { localizePostCards } from '../../lib/translate/content';
import { breadcrumbJsonLd } from '../../lib/seo';

const lang = Astro.locals.lang;
const posts = getPublishedPosts();
// Для списка переводим только заголовок и превью: тело поста — при заходе на страницу
const cards = await localizePostCards(posts, lang);

const jsonLd = [
  breadcrumbJsonLd(
    [
      { name: t(lang, 'nav.home'), path: '/' },
      { name: t(lang, 'pubs.heading'), path: '/publications' },
    ],
    lang,
  ),
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: t(lang, 'pubs.rssTitle'),
    description: t(lang, 'pubs.description'),
    inLanguage: lang,
    blogPost: posts.slice(0, 20).map((p) => ({
      '@type': 'BlogPosting',
      headline: cards.get(p.id)?.title ?? p.title,
      datePublished: p.createdAt,
      url: `${localePath(`/publications/${p.id}`, lang)}`,
    })),
  },
];

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base
  title={t(lang, 'pubs.title')}
  description={t(lang, 'pubs.description')}
  active="pubs"
  jsonLd={jsonLd}
  machineTranslated={lang !== 'ru' && posts.length > 0}
>
  <main>
    <h1>{t(lang, 'pubs.heading')}</h1>
    <p class="lead">{t(lang, 'pubs.lead')}</p>
    <div class="list">
      {posts.length === 0 && <p class="empty">{t(lang, 'pubs.empty')}</p>}
      {
        posts.map((p) => (
          <a class="post glass" href={localePath(`/publications/${p.id}`, lang)} data-ripple>
            <div class="post-head">
              <span class:list={['badge', p.source === 'telegram' ? 'badge-tg' : 'badge-admin']}>
                {p.source === 'telegram' ? t(lang, 'pubs.badgeTelegram') : t(lang, 'pubs.badgeAdmin')}
              </span>
              {
                p.tgMessageId && (
                  <span class="tg-plane" title={t(lang, 'pubs.tgSynced')}>
                    <Icon name="telegram" size={15} />
                  </span>
                )
              }
              <span class="date">{formatDate(p.createdAt, lang)}</span>
            </div>
            <h2>{cards.get(p.id)?.title ?? p.title}</h2>
            <p class="excerpt">{cards.get(p.id)?.excerpt ?? ''}</p>
          </a>
        ))
      }
    </div>
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(26px, 5.5vw, 48px) clamp(14px, 4vw, 24px) 80px;
  }
  h1 {
    margin: 0 0 8px;
    font-size: clamp(24px, 6vw, 30px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .lead {
    margin: 0 0 26px;
    font-size: 14.5px;
    color: var(--fg-55);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .empty {
    margin: 0;
    font-size: 14.5px;
    color: var(--fg-55);
  }
  .post {
    display: block;
    border-radius: 26px;
    padding: clamp(16px, 4vw, 28px);
    background: var(--glass-05);
    text-decoration: none;
    transition: background 0.25s;
  }
  .post:hover {
    background: var(--glass-08);
  }
  .post-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .date {
    font-size: 12.5px;
    color: var(--fg-50);
    white-space: nowrap;
  }
  .tg-plane {
    display: inline-flex;
    color: #2a97e1;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 19px;
    font-weight: 700;
  }
  .excerpt {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-body);
    text-wrap: pretty;
  }
</style>
