---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../lib/queries';
import { formatDate } from '../../lib/format';
import { excerpt } from '../../lib/markdown';

const posts = getPublishedPosts();

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base title="Публикации — NORMno" active="pubs">
  <main>
    <h1>Публикации</h1>
    <p class="lead">Новости из admin-панели и посты из Telegram-канала</p>
    <div class="list">
      {posts.length === 0 && <p class="empty">Публикаций пока нет.</p>}
      {
        posts.map((p) => (
          <a class="post glass" href={`/publications/${p.id}`} data-ripple>
            <div class="post-head">
              <span class:list={['badge', p.source === 'telegram' ? 'badge-tg' : 'badge-admin']}>
                {p.source === 'telegram' ? 'TELEGRAM' : 'ADMIN'}
              </span>
              <span class="date">{formatDate(p.createdAt)}</span>
            </div>
            <h2>{p.title}</h2>
            <p class="excerpt">{excerpt(p.bodyMd)}</p>
          </a>
        ))
      }
    </div>
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(26px, 5.5vw, 48px) clamp(14px, 4vw, 24px) 80px;
  }
  h1 {
    margin: 0 0 8px;
    font-size: clamp(24px, 6vw, 30px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .lead {
    margin: 0 0 26px;
    font-size: 14.5px;
    color: var(--fg-55);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .empty {
    margin: 0;
    font-size: 14.5px;
    color: var(--fg-55);
  }
  .post {
    display: block;
    border-radius: 26px;
    padding: clamp(16px, 4vw, 28px);
    background: var(--glass-05);
    text-decoration: none;
    transition: background 0.25s;
  }
  .post:hover {
    background: var(--glass-08);
  }
  .post-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .date {
    font-size: 12.5px;
    color: var(--fg-50);
    white-space: nowrap;
  }
  h2 {
    margin: 0 0 8px;
    font-size: 19px;
    font-weight: 700;
  }
  .excerpt {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-body);
    text-wrap: pretty;
  }
</style>
