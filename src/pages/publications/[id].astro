---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPost } from '../../lib/queries';
import { formatDate } from '../../lib/format';
import { tgChannelName, tgPostUrl } from '../../lib/telegram';

const id = Number.parseInt(Astro.params.id ?? '', 10);
const post = Number.isFinite(id) ? getPost(id) : undefined;
if (!post || post.status !== 'published') {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const channelName = post.tgMessageId ? tgChannelName() : null;
const channelPostUrl = post.tgMessageId ? tgPostUrl(post.tgMessageId) : null;

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base title={`${post.title} — публикации NORMno`} active="pubs">
  <main>
    <a class="back glass" href="/publications" data-ripple><span class="back-arrow">‹</span> Все публикации</a>
    <article class="glass">
      <div class="head">
        <span class:list={['badge', post.source === 'telegram' ? 'badge-tg' : 'badge-admin']}>
          {post.source === 'telegram' ? 'TELEGRAM' : 'ADMIN'}
        </span>
        <span class="date">{formatDate(post.createdAt)}</span>
      </div>
      <h1>{post.title}</h1>
      <div class="md-body" set:html={post.bodyHtml} />
      {
        channelName && channelPostUrl && (
          <a class="tg-sync" href={channelPostUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="telegram" size={16} />
            Публикация синхронизирована с каналом @{channelName}
          </a>
        )
      }
    </article>
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 44px) clamp(14px, 4vw, 24px) 80px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 15px;
    font-weight: 600;
    padding: 11px 22px 11px 16px;
    border-radius: 20px;
    text-decoration: none;
    background: var(--glass-07);
    transition: background 0.25s;
  }
  .back:hover {
    background: var(--glass-10);
  }
  .back-arrow {
    font-size: 24px;
    line-height: 0.8;
    margin-top: -2px;
  }
  article {
    border-radius: 30px;
    padding: clamp(20px, 4.5vw, 36px);
    box-shadow: var(--shadow-lg);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .date {
    font-size: 12.5px;
    color: var(--fg-50);
  }
  h1 {
    margin: 0 0 18px;
    font-size: clamp(22px, 5.5vw, 28px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .tg-sync {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    padding: 9px 16px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 600;
    color: #2a97e1;
    background: var(--badge-tg-bg);
    border: 1px solid var(--tint-tg-line);
    text-decoration: none;
    transition: filter 0.25s;
  }
  .tg-sync:hover {
    filter: brightness(1.12);
  }
</style>
