---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPost } from '../../lib/queries';
import { formatDate } from '../../lib/format';
import { tgChannelName, tgPostUrl } from '../../lib/telegram';
import { localePath } from '../../lib/i18n';
import { t } from '../../lib/i18n/dict';
import { localizePost } from '../../lib/translate/content';
import { blogPostingJsonLd, breadcrumbJsonLd } from '../../lib/seo';

const lang = Astro.locals.lang;
const id = Number.parseInt(Astro.params.id ?? '', 10);
const post = Number.isFinite(id) ? getPost(id) : undefined;
if (!post || post.status !== 'published') {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

// Ленивый перевод: старый пост переводится, когда на него впервые зашли,
// и дальше отдаётся из кеша БД. Не успели за отведённое время — покажем оригинал.
const content = await localizePost(post, lang);

const channelName = post.tgMessageId ? tgChannelName() : null;
const channelPostUrl = post.tgMessageId ? tgPostUrl(post.tgMessageId) : null;
const path = `/publications/${post.id}`;

const jsonLd = [
  blogPostingJsonLd(
    {
      title: content.title,
      excerpt: content.excerpt,
      createdAt: post.createdAt,
      updatedAt: post.updatedAt,
      path,
      image: post.coverUrl,
    },
    lang,
  ),
  breadcrumbJsonLd(
    [
      { name: t(lang, 'nav.home'), path: '/' },
      { name: t(lang, 'pubs.heading'), path: '/publications' },
      { name: content.title, path },
    ],
    lang,
  ),
];

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base
  title={`${content.title} — ${t(lang, 'pubs.rssTitle')}`}
  description={content.excerpt}
  active="pubs"
  ogType="article"
  image={post.coverUrl || undefined}
  jsonLd={jsonLd}
  publishedTime={post.createdAt}
  modifiedTime={post.updatedAt}
  machineTranslated={lang !== 'ru' && content.translated}
>
  <main>
    <a class="back glass" href={localePath('/publications', lang)} data-ripple>
      <span class="back-arrow">‹</span> {t(lang, 'pubs.back')}
    </a>
    <article class="glass">
      <div class="head">
        <span class:list={['badge', post.source === 'telegram' ? 'badge-tg' : 'badge-admin']}>
          {post.source === 'telegram' ? t(lang, 'pubs.badgeTelegram') : t(lang, 'pubs.badgeAdmin')}
        </span>
        <span class="date">{formatDate(post.createdAt, lang)}</span>
      </div>
      <h1>{content.title}</h1>
      <div class="md-body" set:html={content.bodyHtml} />
      {
        channelName && channelPostUrl && (
          <a class="tg-sync" href={channelPostUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="telegram" size={16} />
            {t(lang, 'pubs.tgSyncedLink', { channel: channelName })}
          </a>
        )
      }
    </article>
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 44px) clamp(14px, 4vw, 24px) 80px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    padding: 13px 26px 13px 18px;
    border-radius: 22px;
    text-decoration: none;
    background: var(--glass-07);
    transition: background 0.25s;
  }
  .back:hover {
    background: var(--glass-10);
  }
  .back-arrow {
    font-size: 30px;
    line-height: 0.7;
    margin-top: -3px;
  }
  article {
    border-radius: 30px;
    padding: clamp(20px, 4.5vw, 36px);
    box-shadow: var(--shadow-lg);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .date {
    font-size: 12.5px;
    color: var(--fg-50);
  }
  h1 {
    margin: 0 0 18px;
    font-size: clamp(22px, 5.5vw, 28px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .tg-sync {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    padding: 9px 16px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 600;
    color: #2a97e1;
    background: var(--badge-tg-bg);
    border: 1px solid var(--tint-tg-line);
    text-decoration: none;
    transition: filter 0.25s;
  }
  .tg-sync:hover {
    filter: brightness(1.12);
  }
</style>
