---
import Base from '../../layouts/Base.astro';
import { getPost } from '../../lib/queries';
import { formatDate } from '../../lib/format';

const id = Number.parseInt(Astro.params.id ?? '', 10);
const post = Number.isFinite(id) ? getPost(id) : undefined;
if (!post || post.status !== 'published') {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base title={`${post.title} — публикации NORMno`} active="pubs">
  <main>
    <a class="back glass" href="/publications" data-ripple>‹ Все публикации</a>
    <article class="glass">
      <div class="head">
        <span class:list={['badge', post.source === 'telegram' ? 'badge-tg' : 'badge-admin']}>
          {post.source === 'telegram' ? 'TELEGRAM' : 'ADMIN'}
        </span>
        <span class="date">{formatDate(post.createdAt)}</span>
      </div>
      <h1>{post.title}</h1>
      <div class="md-body" set:html={post.bodyHtml} />
    </article>
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 44px) clamp(14px, 4vw, 24px) 80px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .back {
    align-self: flex-start;
    font-size: 14px;
    padding: 8px 18px;
    border-radius: 18px;
    text-decoration: none;
    background: var(--glass-07);
  }
  article {
    border-radius: 30px;
    padding: clamp(20px, 4.5vw, 36px);
    box-shadow: var(--shadow-lg);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .date {
    font-size: 12.5px;
    color: var(--fg-50);
  }
  h1 {
    margin: 0 0 18px;
    font-size: clamp(22px, 5.5vw, 28px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }
</style>
