---
import Base from '../layouts/Base.astro';
---

<Base title="404 — страница не найдена">
  <main>
    <section class="glass">
      <h1>404</h1>
      <p>Такой страницы нет. Возможно, она уехала в другой релиз.</p>
      <a class="btn-accent" href="/" data-ripple>На главную</a>
    </section>
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(40px, 10vw, 96px) clamp(14px, 4vw, 24px) 80px;
  }
  section {
    border-radius: 32px;
    padding: clamp(28px, 6vw, 48px);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  h1 {
    margin: 0 0 10px;
    font-size: clamp(48px, 12vw, 72px);
    font-weight: 800;
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  p {
    margin: 0 0 24px;
    font-size: 15px;
    color: var(--fg-60);
  }
</style>
