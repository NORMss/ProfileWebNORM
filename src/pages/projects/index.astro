---
import Base from '../../layouts/Base.astro';
import {
  getVisibleRepos,
  getLatestReleaseDates,
  normalizeProjectsSort,
  repoImage,
  sortRepos,
} from '../../lib/queries';
import { getSetting } from '../../lib/settings';
import { formatCount } from '../../lib/format';
import { localePath } from '../../lib/i18n';
import { t } from '../../lib/i18n/dict';
import { localizeRepoDescriptions } from '../../lib/translate/content';
import { breadcrumbJsonLd } from '../../lib/seo';

const lang = Astro.locals.lang;
const releaseDates = getLatestReleaseDates();
const defaultSort = normalizeProjectsSort(getSetting('projects_sort'));
const hard = sortRepos(getVisibleRepos('hard'), defaultSort, releaseDates);
const vibe = sortRepos(getVisibleRepos('vibe'), defaultSort, releaseDates);
// Описания короткие — переводим весь список одной пачкой и кешируем
const descriptions = await localizeRepoDescriptions([...hard, ...vibe], lang);

const sortOptions = [
  { value: 'released', label: t(lang, 'projects.sortReleased') },
  { value: 'downloads', label: t(lang, 'projects.sortDownloads') },
  { value: 'stars', label: t(lang, 'projects.sortStars') },
];

const jsonLd = [
  breadcrumbJsonLd(
    [
      { name: t(lang, 'nav.home'), path: '/' },
      { name: t(lang, 'projects.heading'), path: '/projects' },
    ],
    lang,
  ),
];

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base
  title={t(lang, 'projects.title')}
  description={t(lang, 'projects.description')}
  active="projects"
  jsonLd={jsonLd}
  machineTranslated={lang !== 'ru'}
>
  <main>
    <div class="head">
      <h1>{t(lang, 'projects.heading')}</h1>
      <div class="tabs glass" role="tablist">
        <button id="tab-hard" class="tab active" role="tab" aria-selected="true" aria-controls="grid-hard" data-ripple>
          {t(lang, 'projects.tabHard')}
        </button>
        <button id="tab-vibe" class="tab" role="tab" aria-selected="false" aria-controls="grid-vibe" data-ripple>
          {t(lang, 'projects.tabVibe')}
        </button>
      </div>
    </div>

    <div class="controls">
      <input
        id="project-search"
        class="search glass-item"
        type="search"
        placeholder={t(lang, 'projects.search')}
        aria-label={t(lang, 'projects.searchLabel')}
        autocomplete="off"
      />
      <select id="project-sort" class="sort glass-item" aria-label={t(lang, 'projects.sortLabel')}>
        {sortOptions.map((o) => <option value={o.value} selected={o.value === defaultSort}>{o.label}</option>)}
      </select>
    </div>

    {
      [
        { id: 'hard', list: hard, hidden: false },
        { id: 'vibe', list: vibe, hidden: true },
      ].map(({ id, list, hidden }) => (
        <div class="grid" id={`grid-${id}`} role="tabpanel" hidden={hidden}>
          {list.length === 0 && <p class="empty">{t(lang, 'projects.emptyCategory')}</p>}
          {list.map((p) => (
            <a
              class="card"
              href={localePath(`/projects/${p.name}`, lang)}
              data-search={`${p.name} ${p.description} ${descriptions.get(p.id) ?? ''}`.toLowerCase()}
              data-stars={p.stars}
              data-downloads={p.totalDownloads}
              data-released={releaseDates.get(p.id) || p.pushedAt}
              data-ripple
            >
              <img class="shot" src={repoImage(p)} alt={t(lang, 'projects.screenshotAlt', { name: p.name })} loading="lazy" />
              <div class="card-info glass">
                <div class="card-top">
                  <strong>{p.name}</strong>
                  <span class="card-stats">
                    <span>★ {formatCount(p.stars, lang)}</span>
                    <span>↓ {formatCount(p.totalDownloads, lang)}</span>
                  </span>
                </div>
                <div class="card-desc">{descriptions.get(p.id) ?? p.description}</div>
              </div>
            </a>
          ))}
          <p class="empty no-results" hidden>
            {t(lang, 'projects.noResults')}
          </p>
        </div>
      ))
    }
  </main>
</Base>

<script>
  // Вкладки Hard/Vibe + сортировка и поиск — всё на клиенте, списки уже в HTML.
  const tabs = [
    { btn: document.getElementById('tab-hard')!, panel: document.getElementById('grid-hard')! },
    { btn: document.getElementById('tab-vibe')!, panel: document.getElementById('grid-vibe')! },
  ];
  for (const { btn } of tabs) {
    btn.addEventListener('click', () => {
      for (const t of tabs) {
        const on = t.btn === btn;
        t.btn.classList.toggle('active', on);
        t.btn.setAttribute('aria-selected', String(on));
        t.panel.hidden = !on;
      }
    });
  }
  if (location.hash === '#vibe') tabs[1].btn.click();

  const search = document.getElementById('project-search') as HTMLInputElement;
  const sortSel = document.getElementById('project-sort') as HTMLSelectElement;

  function apply() {
    const q = search.value.trim().toLowerCase();
    const sort = sortSel.value;
    for (const { panel } of tabs) {
      const cards = [...panel.querySelectorAll<HTMLElement>('.card')];
      cards.sort((a, b) => {
        if (sort === 'downloads') return Number(b.dataset.downloads) - Number(a.dataset.downloads);
        if (sort === 'stars') return Number(b.dataset.stars) - Number(a.dataset.stars);
        return (b.dataset.released ?? '').localeCompare(a.dataset.released ?? '');
      });
      let visible = 0;
      for (const card of cards) {
        panel.appendChild(card); // переставляем в отсортированном порядке
        const hit = !q || (card.dataset.search ?? '').includes(q);
        card.style.display = hit ? '' : 'none';
        if (hit) visible++;
      }
      const noResults = panel.querySelector<HTMLElement>('.no-results');
      if (noResults) {
        panel.appendChild(noResults);
        noResults.hidden = !(q && visible === 0 && cards.length > 0);
      }
    }
  }

  search.addEventListener('input', apply);
  sortSel.addEventListener('change', apply);
</script>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 1060px;
    margin: 0 auto;
    padding: clamp(26px, 5.5vw, 48px) clamp(14px, 4vw, 24px) 80px;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 18px;
  }
  h1 {
    margin: 0;
    font-size: clamp(24px, 6vw, 30px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .tabs {
    display: flex;
    gap: 4px;
    padding: 5px;
    border-radius: 22px;
    background: var(--glass-07);
  }
  .tab {
    font: inherit;
    color: inherit;
    border: none;
    background: transparent;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    padding: 8px clamp(12px, 3.5vw, 20px);
    border-radius: 17px;
    transition: background 0.3s;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }
  .tab.active {
    background: var(--active);
  }

  .controls {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .search {
    flex: 1;
    min-width: min(240px, 100%);
    font: inherit;
    font-size: 14px;
    color: var(--fg);
    padding: 11px 18px;
    border-radius: 18px;
    outline: none;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .search::placeholder {
    color: var(--fg-45);
  }
  .search:focus {
    border-color: rgba(157, 183, 255, 0.5);
  }
  .sort {
    font: inherit;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--fg);
    padding: 11px 14px;
    border-radius: 18px;
    outline: none;
    cursor: pointer;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .sort option {
    color: #1a1a1a;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 22px;
  }
  .grid[hidden] {
    display: none;
  }
  .empty {
    margin: 0;
    font-size: 14.5px;
    color: var(--fg-55);
  }
  .no-results {
    grid-column: 1 / -1;
  }
  .card {
    position: relative;
    display: block;
    border-radius: 26px;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    border: 1px solid var(--line-15);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    background: var(--glass-05);
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-info {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    border-radius: 18px;
    padding: 14px 16px;
    background: var(--card-overlay);
    border: 1px solid var(--line-15);
  }
  .card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .card-top strong {
    font-size: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card-stats {
    display: flex;
    gap: 10px;
    font-size: 12.5px;
    color: var(--fg-65);
    flex: none;
    white-space: nowrap;
  }
  .card-desc {
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--fg-65);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
