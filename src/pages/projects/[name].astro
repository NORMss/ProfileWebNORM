---
import Base from '../../layouts/Base.astro';
import DownloadMenu from '../../components/DownloadMenu.astro';
import { getRepoByName, getReleases, getAssets, getIssues, repoImage } from '../../lib/queries';
import { formatCount, formatDate } from '../../lib/format';
import { localePath } from '../../lib/i18n';
import { t } from '../../lib/i18n/dict';
import { localizeRepo } from '../../lib/translate/content';
import { absoluteAsset, breadcrumbJsonLd, softwareJsonLd } from '../../lib/seo';

const lang = Astro.locals.lang;
const { name = '' } = Astro.params;
const repo = getRepoByName(name);
if (!repo) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const releases = getReleases(repo.id).map((r) => ({ ...r, assets: getAssets(r.id) }));
const issues = getIssues(repo.id);
// Файлы последнего релиза — для выпадающего меню «Скачать последнюю версию»
const latestAssets = releases[0]?.assets ?? [];

// README чаще всего уже на английском — эвристика в переводчике это увидит
// и не потратит ни одного символа лимита.
const content = await localizeRepo(repo, lang);
const path = `/projects/${repo.name}`;

const jsonLd = [
  softwareJsonLd(
    {
      name: repo.name,
      description: content.description,
      htmlUrl: repo.htmlUrl,
      stars: repo.stars,
      path,
      image: absoluteAsset(repoImage(repo)),
    },
    lang,
  ),
  breadcrumbJsonLd(
    [
      { name: t(lang, 'nav.home'), path: '/' },
      { name: t(lang, 'projects.heading'), path: '/projects' },
      { name: repo.name, path },
    ],
    lang,
  ),
];

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base
  title={`${repo.name} — ${t(lang, 'projects.title')}`}
  description={content.description || t(lang, 'projects.description')}
  active="projects"
  image={repoImage(repo)}
  jsonLd={jsonLd}
  machineTranslated={lang !== 'ru' && content.translated}
>
  <main>
    <a class="back glass" href={localePath('/projects', lang)} data-ripple>
      <span class="back-arrow">‹</span> {t(lang, 'projects.back')}
    </a>

    <section class="glass card-main">
      <div class="top">
        <div>
          <h1>{repo.name}</h1>
          <div class="meta">
            <span>★ {formatCount(repo.stars, lang)} {t(lang, 'projects.stars')}</span>
            <span>↓ {formatCount(repo.totalDownloads, lang)} {t(lang, 'projects.downloads')}</span>
            {repo.latestTag && <span class="tag">{repo.latestTag}</span>}
          </div>
        </div>
        {
          latestAssets.length > 0 ? (
            <DownloadMenu assets={latestAssets} label={t(lang, 'download.latest')} variant="accent" lang={lang} />
          ) : repo.latestAssetUrl ? (
            <a class="btn-accent" href={repo.latestAssetUrl} data-ripple>
              ⤓ {t(lang, 'download.latest')}
            </a>
          ) : (
            <a class="btn-ghost" href={repo.htmlUrl} target="_blank" rel="noopener noreferrer" data-ripple>
              {t(lang, 'projects.openGithub')}
            </a>
          )
        }
      </div>

      {content.readmeHtml && <h2 class="readme-head">{t(lang, 'projects.readme')}</h2>}
      {content.readmeHtml && <div class="md-body" set:html={content.readmeHtml} />}
    </section>

    <section class="glass card-list">
      <h2>{t(lang, 'projects.releases')}</h2>
      {releases.length === 0 && <p class="empty">{t(lang, 'projects.releasesEmpty')}</p>}
      <div class="rows">
        {
          releases.map((r) => (
            <div class="row glass-item">
              <span class="row-tag">{r.tag}</span>
              <span class="row-notes">{r.name || r.notes}</span>
              <span class="row-date">{formatDate(r.publishedAt, lang)}</span>
              <span class="row-dl">↓ {formatCount(r.downloads, lang)}</span>
              <DownloadMenu
                assets={r.assets}
                label={
                  r.assets.length > 1
                    ? t(lang, 'download.many', { count: r.assets.length })
                    : t(lang, 'download.one')
                }
                variant="row"
                fallbackUrl={r.htmlUrl}
                fallbackLabel={t(lang, 'download.open')}
                lang={lang}
              />
            </div>
          ))
        }
      </div>
    </section>

    <section class="glass card-list">
      <h2>{t(lang, 'projects.issues')}</h2>
      {issues.length === 0 && <p class="empty">{t(lang, 'projects.issuesEmpty')}</p>}
      <div class="rows">
        {
          issues.map((i) => (
            <a class="row glass-item issue" href={i.htmlUrl} target="_blank" rel="noopener noreferrer" data-ripple>
              <span class="issue-num">#{i.number}</span>
              <span class="row-notes">{i.title}</span>
              <span class="row-date">{formatDate(i.createdAt, lang)}</span>
              {i.comments > 0 && <span class="row-dl">💬 {i.comments}</span>}
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 44px) clamp(14px, 4vw, 24px) 80px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    padding: 13px 26px 13px 18px;
    border-radius: 22px;
    text-decoration: none;
    background: var(--glass-07);
    transition: background 0.25s;
  }
  .back:hover {
    background: var(--glass-10);
  }
  .back-arrow {
    font-size: 30px;
    line-height: 0.7;
    margin-top: -3px;
  }
  .card-main {
    border-radius: 30px;
    padding: clamp(20px, 4.5vw, 36px);
    box-shadow: var(--shadow-lg);
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
  }
  h1 {
    margin: 0 0 6px;
    font-size: clamp(24px, 6vw, 30px);
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .meta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13.5px;
    color: var(--fg-60);
  }
  .tag {
    color: var(--green);
    font-family: ui-monospace, Menlo, monospace;
  }
  .btn-accent {
    font-size: clamp(13.5px, 3.8vw, 15px);
    white-space: nowrap;
    flex: none;
    padding: 13px clamp(16px, 4vw, 26px);
    border-radius: 20px;
  }
  .readme-head {
    margin: 26px 0 10px;
    font-size: 17px;
    font-weight: 700;
  }
  .card-list {
    border-radius: 28px;
    padding: clamp(16px, 4vw, 28px);
    background: var(--glass-05);
  }
  .card-list h2 {
    margin: 0 0 16px;
    font-size: 18px;
    font-weight: 700;
  }
  .empty {
    margin: 0;
    font-size: 14px;
    color: var(--fg-55);
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    padding: 13px 18px;
    border-radius: 18px;
    text-decoration: none;
  }
  .row-tag {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 13px;
    color: var(--green);
    flex: none;
    min-width: 64px;
  }
  .row-notes {
    flex: 1;
    min-width: min(220px, 100%);
    font-size: 14px;
    color: var(--text-body);
  }
  .row-date {
    font-size: 12.5px;
    color: var(--fg-50);
    flex: none;
    white-space: nowrap;
  }
  .row-dl {
    font-size: 12.5px;
    color: var(--fg-60);
    flex: none;
    white-space: nowrap;
  }
  .issue:hover {
    background: var(--glass-08);
  }
  .issue-num {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 13px;
    color: var(--fg-55);
    flex: none;
    min-width: 44px;
  }
</style>
