---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Heatmap from '../components/Heatmap.astro';
import SpotifyWidget from '../components/SpotifyWidget.svelte';
import { getAbout, getAboutHtml, getAvatarUrl, getSetting } from '../lib/settings';
import { getLatestUpdates, getPublishedPosts, repoImage } from '../lib/queries';
import { formatCount, formatDate } from '../lib/format';
import { getNowPlaying } from '../lib/spotify';
import { localePath } from '../lib/i18n';
import { t } from '../lib/i18n/dict';
import { localizeAbout, localizePostCards, localizeRepoDescriptions } from '../lib/translate/content';
import { personJsonLd, webSiteJsonLd } from '../lib/seo';

const lang = Astro.locals.lang;
const about = getAbout();
const avatarUrl = getAvatarUrl();
const updates = getLatestUpdates(3);
const posts = getPublishedPosts(3);
const nowPlaying = await getNowPlaying();

// Перевод главной: блок «обо мне», описания проектов и карточки публикаций.
// Всё берётся из кеша, а недостающее переводится один раз при первом заходе.
const aboutHtml = await localizeAbout(getAboutHtml(), lang);
const repoDescriptions = await localizeRepoDescriptions(
  updates.map((u) => u.repo),
  lang,
);
const postCards = await localizePostCards(posts, lang);

let contributions: { total: number; weeks: (readonly [string, number])[][] } | null = null;
try {
  contributions = JSON.parse(getSetting('gh_contributions') || 'null');
} catch {
  contributions = null;
}
let claudeActivity: { total: number; byDate: Record<string, number> } | null = null;
try {
  claudeActivity = JSON.parse(getSetting('claude_contributions') || 'null');
} catch {
  claudeActivity = null;
}

const links = [
  { icon: 'telegram' as const, label: 'Telegram', href: about.telegram, cls: 'link-tg' },
  { icon: 'video' as const, label: 'YouTube', href: about.youtube, cls: 'link-yt' },
  { icon: 'github' as const, label: 'GitHub', href: about.github, cls: 'link-gh' },
].filter((l) => l.href);

const jsonLd = [personJsonLd(lang, about), webSiteJsonLd(lang)];

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base
  title={t(lang, 'home.title')}
  description={t(lang, 'home.description')}
  active="home"
  jsonLd={jsonLd}
  machineTranslated={lang !== 'ru'}
>
  <main>
    <section class="hero glass">
      <div class="hero-row">
        <img class="avatar" src={avatarUrl} alt={t(lang, 'home.avatarAlt')} width="104" height="104" />
        <div class="hero-body">
          <div class="hero-text md-body" set:html={aboutHtml} />
          <div class="social-row">
            {
              links.map((l) => (
                <a
                  class:list={['social-icon', l.cls]}
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={l.label}
                  title={l.label}
                  data-ripple
                >
                  <Icon name={l.icon} size={22} />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <div class="columns">
      <section class="updates glass">
        <h2>
          {t(lang, 'home.updates')} <span class="sub">{t(lang, 'home.updatesSub')}</span>
        </h2>
        <div class="update-list">
          {
            updates.length === 0 && (
              <p class="empty">{t(lang, 'home.updatesEmpty')}</p>
            )
          }
          {
            updates.map((u) => (
              <a class="update glass-item" href={localePath(`/projects/${u.repo.name}`, lang)} data-ripple>
                <img class="thumb" src={repoImage(u.repo)} alt="" width="52" height="52" loading="lazy" />
                <div class="update-meta">
                  <div class="update-title">
                    <strong>{u.repo.name}</strong>
                    <span class="tag">{u.tag}</span>
                  </div>
                  <div class="update-desc">{u.name || u.notes || repoDescriptions.get(u.repo.id) || u.repo.description}</div>
                </div>
                <div class="stats">
                  <span>★ {formatCount(u.repo.stars, lang)}</span>
                  <span>↓ {formatCount(u.repo.totalDownloads, lang)}</span>
                </div>
                <span class="chevron">›</span>
              </a>
            ))
          }
        </div>
      </section>

      <SpotifyWidget client:load initial={nowPlaying} lang={lang} />
    </div>

    {
      posts.length > 0 && (
        <section class="posts glass">
          <h2>
            {t(lang, 'home.posts')}
            <a class="all" href={localePath('/publications', lang)}>
              {t(lang, 'home.allPosts')}
            </a>
          </h2>
          <div class="post-list">
            {posts.map((p) => (
              <a class="post glass-item" href={localePath(`/publications/${p.id}`, lang)} data-ripple>
                <div class="post-head">
                  <span class:list={['badge', p.source === 'telegram' ? 'badge-tg' : 'badge-admin']}>
                    {p.source === 'telegram' ? t(lang, 'pubs.badgeTelegram') : t(lang, 'pubs.badgeAdmin')}
                  </span>
                  <span class="post-date">{formatDate(p.createdAt, lang)}</span>
                </div>
                <div class="post-title">{postCards.get(p.id)?.title ?? p.title}</div>
                <p class="post-excerpt">{postCards.get(p.id)?.excerpt ?? ''}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      contributions && contributions.weeks.length > 0 && (
        <Heatmap total={contributions.total} weeks={contributions.weeks} claude={claudeActivity} lang={lang} />
      )
    }
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 1060px;
    margin: 0 auto;
    padding: clamp(28px, 6vw, 56px) clamp(14px, 4vw, 24px) 80px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero {
    border-radius: 32px;
    padding: clamp(22px, 5vw, 44px);
    background: var(--glass-06);
    box-shadow:
      var(--shadow-lg),
      inset 0 1px 0 var(--inset-top);
  }
  .hero-row {
    display: flex;
    gap: 32px;
    align-items: center;
    flex-wrap: wrap;
  }
  .avatar {
    width: clamp(104px, 17vw, 220px);
    height: clamp(104px, 17vw, 220px);
    border-radius: 50%;
    flex: none;
    border: 1px solid var(--line-18);
    background: var(--glass-06);
    object-fit: cover;
  }
  .hero-body {
    flex: 1;
    min-width: min(280px, 100%);
  }
  .hero-text {
    font-size: 17px;
    line-height: 1.55;
    max-width: 560px;
    text-wrap: pretty;
  }
  .hero-text :global(h1) {
    margin: 0 0 10px;
    font-size: clamp(26px, 6.5vw, 34px);
    font-weight: 800;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }
  .hero-text :global(p) {
    margin: 0 0 8px;
  }
  .hero-text :global(p:last-child) {
    margin-bottom: 0;
  }
  .social-row {
    display: flex;
    gap: 12px;
    margin-top: 18px;
  }
  .social-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      filter 0.25s,
      transform 0.25s;
  }
  .social-icon:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }
  .link-tg {
    color: #2a97e1;
    background: var(--tint-tg-bg);
    border: 1px solid var(--tint-tg-line);
  }
  .link-yt {
    color: #e04c4c;
    background: var(--tint-yt-bg);
    border: 1px solid var(--tint-yt-line);
  }
  .link-gh {
    color: var(--fg);
    background: var(--tint-gh-bg);
    border: 1px solid var(--tint-gh-line);
  }

  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(16px, 3vw, 28px);
    align-items: flex-start;
  }
  .updates {
    flex: 999 1 420px;
    min-width: min(420px, 100%);
    border-radius: 28px;
    padding: clamp(18px, 4vw, 28px);
    background: var(--glass-05);
    box-shadow: var(--shadow-md);
  }
  h2 {
    margin: 0 0 18px;
    font-size: 19px;
    font-weight: 700;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .sub {
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-50);
  }
  .update-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .empty {
    margin: 0;
    font-size: 14px;
    color: var(--fg-55);
  }
  .update {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 12px 16px;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.25s;
  }
  .update:hover {
    background: var(--glass-08);
  }
  .thumb {
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid var(--line-14);
    background: var(--glass-05);
  }
  .update-meta {
    flex: 1;
    min-width: 0;
  }
  .update-title {
    display: flex;
    gap: 8px;
    align-items: baseline;
    overflow: hidden;
  }
  .update-title strong {
    font-size: 14.5px;
    white-space: nowrap;
  }
  .tag {
    font-size: 12px;
    color: var(--green);
    font-family: ui-monospace, Menlo, monospace;
    white-space: nowrap;
  }
  .update-desc {
    font-size: 13px;
    color: var(--fg-60);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .stats {
    display: flex;
    gap: 12px;
    font-size: 12.5px;
    color: var(--fg-60);
    flex: none;
    white-space: nowrap;
  }
  .chevron {
    color: var(--fg-45);
    font-size: 16px;
  }
  @media (max-width: 560px) {
    .stats {
      display: none;
    }
  }

  /* Последние публикации */
  .posts {
    border-radius: 28px;
    padding: clamp(18px, 4vw, 28px);
    background: var(--glass-05);
    box-shadow: var(--shadow-md);
  }
  .all {
    margin-left: auto;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--fg-55);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s;
  }
  .all:hover {
    color: var(--fg);
  }
  .post-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }
  .post {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.25s;
  }
  .post:hover {
    background: var(--glass-08);
  }
  .post-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .post-date {
    font-size: 12px;
    color: var(--fg-50);
    white-space: nowrap;
    margin-left: auto;
  }
  .post-title {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-excerpt {
    margin: 6px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--fg-60);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
