---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Heatmap from '../components/Heatmap.astro';
import SpotifyWidget from '../components/SpotifyWidget.svelte';
import { getAbout, getAboutHtml, getAvatarUrl, getSetting } from '../lib/settings';
import { getLatestUpdates, repoImage } from '../lib/queries';
import { formatCount } from '../lib/format';
import { getNowPlaying } from '../lib/spotify';

const about = getAbout();
const aboutHtml = getAboutHtml();
const avatarUrl = getAvatarUrl();
const updates = getLatestUpdates(5);
const nowPlaying = await getNowPlaying();

let contributions: { total: number; weeks: (readonly [string, number])[][] } | null = null;
try {
  contributions = JSON.parse(getSetting('gh_contributions') || 'null');
} catch {
  contributions = null;
}

const links = [
  { icon: 'telegram' as const, label: 'Telegram', href: about.telegram, cls: 'link-tg' },
  { icon: 'video' as const, label: 'YouTube', href: about.youtube, cls: 'link-yt' },
  { icon: 'github' as const, label: 'GitHub', href: about.github, cls: 'link-gh' },
].filter((l) => l.href);

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Base title="NORMno — портфолио и проекты на KMP" active="home">
  <main>
    <section class="hero glass">
      <div class="hero-row">
        <img class="avatar" src={avatarUrl} alt="Фото NORMno" width="104" height="104" />
        <div class="hero-body">
          <div class="hero-text md-body" set:html={aboutHtml} />
          <div class="social-row">
            {
              links.map((l) => (
                <a
                  class:list={['social-icon', l.cls]}
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={l.label}
                  title={l.label}
                  data-ripple
                >
                  <Icon name={l.icon} size={22} />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <div class="columns">
      <section class="updates glass">
        <h2>Последние обновления <span class="sub">releases · GitHub</span></h2>
        <div class="update-list">
          {
            updates.length === 0 && (
              <p class="empty">Пока пусто — релизы появятся после первого синка с GitHub.</p>
            )
          }
          {
            updates.map((u) => (
              <a class="update glass-item" href={`/projects/${u.repo.name}`} data-ripple>
                <img class="thumb" src={repoImage(u.repo)} alt="" width="52" height="52" loading="lazy" />
                <div class="update-meta">
                  <div class="update-title">
                    <strong>{u.repo.name}</strong>
                    <span class="tag">{u.tag}</span>
                  </div>
                  <div class="update-desc">{u.name || u.notes || u.repo.description}</div>
                </div>
                <div class="stats">
                  <span>★ {formatCount(u.repo.stars)}</span>
                  <span>↓ {formatCount(u.repo.totalDownloads)}</span>
                </div>
                <span class="chevron">›</span>
              </a>
            ))
          }
        </div>
      </section>

      <SpotifyWidget client:load initial={nowPlaying} />
    </div>

    {contributions && contributions.weeks.length > 0 && <Heatmap total={contributions.total} weeks={contributions.weeks} />}
  </main>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    max-width: 1060px;
    margin: 0 auto;
    padding: clamp(28px, 6vw, 56px) clamp(14px, 4vw, 24px) 80px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero {
    border-radius: 32px;
    padding: clamp(22px, 5vw, 44px);
    background: var(--glass-06);
    box-shadow:
      var(--shadow-lg),
      inset 0 1px 0 var(--inset-top);
  }
  .hero-row {
    display: flex;
    gap: 32px;
    align-items: center;
    flex-wrap: wrap;
  }
  .avatar {
    width: clamp(104px, 17vw, 220px);
    height: clamp(104px, 17vw, 220px);
    border-radius: 50%;
    flex: none;
    border: 1px solid var(--line-18);
    background: var(--glass-06);
    object-fit: cover;
  }
  .hero-body {
    flex: 1;
    min-width: min(280px, 100%);
  }
  .hero-text {
    font-size: 17px;
    line-height: 1.55;
    max-width: 560px;
    text-wrap: pretty;
  }
  .hero-text :global(h1) {
    margin: 0 0 10px;
    font-size: clamp(26px, 6.5vw, 34px);
    font-weight: 800;
    letter-spacing: -0.5px;
    line-height: 1.2;
  }
  .hero-text :global(p) {
    margin: 0 0 8px;
  }
  .hero-text :global(p:last-child) {
    margin-bottom: 0;
  }
  .social-row {
    display: flex;
    gap: 12px;
    margin-top: 18px;
  }
  .social-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      filter 0.25s,
      transform 0.25s;
  }
  .social-icon:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }
  .link-tg {
    color: #2a97e1;
    background: var(--tint-tg-bg);
    border: 1px solid var(--tint-tg-line);
  }
  .link-yt {
    color: #e04c4c;
    background: var(--tint-yt-bg);
    border: 1px solid var(--tint-yt-line);
  }
  .link-gh {
    color: var(--fg);
    background: var(--tint-gh-bg);
    border: 1px solid var(--tint-gh-line);
  }

  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(16px, 3vw, 28px);
    align-items: flex-start;
  }
  .updates {
    flex: 999 1 420px;
    min-width: min(420px, 100%);
    border-radius: 28px;
    padding: clamp(18px, 4vw, 28px);
    background: var(--glass-05);
    box-shadow: var(--shadow-md);
  }
  h2 {
    margin: 0 0 18px;
    font-size: 19px;
    font-weight: 700;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .sub {
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-50);
  }
  .update-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .empty {
    margin: 0;
    font-size: 14px;
    color: var(--fg-55);
  }
  .update {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 12px 16px;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.25s;
  }
  .update:hover {
    background: var(--glass-08);
  }
  .thumb {
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid var(--line-14);
    background: var(--glass-05);
  }
  .update-meta {
    flex: 1;
    min-width: 0;
  }
  .update-title {
    display: flex;
    gap: 8px;
    align-items: baseline;
    overflow: hidden;
  }
  .update-title strong {
    font-size: 14.5px;
    white-space: nowrap;
  }
  .tag {
    font-size: 12px;
    color: var(--green);
    font-family: ui-monospace, Menlo, monospace;
    white-space: nowrap;
  }
  .update-desc {
    font-size: 13px;
    color: var(--fg-60);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .stats {
    display: flex;
    gap: 12px;
    font-size: 12.5px;
    color: var(--fg-60);
    flex: none;
    white-space: nowrap;
  }
  .chevron {
    color: var(--fg-45);
    font-size: 16px;
  }
  @media (max-width: 560px) {
    .stats {
      display: none;
    }
  }
</style>
