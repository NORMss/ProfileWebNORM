---
import '../styles/global.css';
import LangHint from '../components/LangHint.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import { config } from '../lib/config';
import { DEFAULT_LANG, localePath, type Lang } from '../lib/i18n';
import { t } from '../lib/i18n/dict';
import { absoluteUrl, alternates, ogLocale } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Активный пункт навигации: home | projects | pubs | none */
  active?: string;
  /** Скрыть публичную навигацию (админка) */
  hideNav?: boolean;
  /** Картинка для соцсетей (абсолютный URL или путь от корня) */
  image?: string;
  /** og:type — article для страниц публикаций */
  ogType?: 'website' | 'article';
  /** Убрать страницу из индекса (админка, служебные страницы) */
  noindex?: boolean;
  /** Контент переведён машинно — показываем сноску и не выдаём его за авторский текст */
  machineTranslated?: boolean;
  /** JSON-LD блоки страницы (schema.org) */
  jsonLd?: unknown[];
  /** Даты публикации/правки для og:article */
  publishedTime?: string;
  modifiedTime?: string;
  /** Картинка, с которой начинается первый экран: браузер узнаёт о ней из <head>, не дожидаясь разметки */
  preloadImage?: string;
  /** Внешние хосты картинок этой страницы — соединение открывается заранее */
  preconnect?: string[];
}

const lang: Lang = Astro.locals.lang ?? DEFAULT_LANG;
const path = Astro.locals.path ?? '/';
// Язык браузера отличается от открытого, а выбор посетитель ещё не делал —
// предлагаем другую версию ссылкой (вместо автоматического редиректа).
const suggestLang = Astro.locals.suggestLang ?? null;

const {
  title,
  description = t(lang, 'site.description'),
  active = 'none',
  hideNav = false,
  image = '/avatar.svg',
  ogType = 'website',
  noindex = false,
  machineTranslated = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  preloadImage,
  preconnect = [],
} = Astro.props;

const site = config.siteUrl.replace(/\/$/, '');
const siteHost = config.siteHost;
const canonical = absoluteUrl(path, lang);
const langLinks = alternates(path);
const imageUrl = image.startsWith('http') ? image : `${site}${image}`;
const showTranslationNote = machineTranslated && lang !== DEFAULT_LANG;

const nav = [
  { href: localePath('/', lang), label: t(lang, 'nav.home'), key: 'home' },
  { href: localePath('/projects', lang), label: t(lang, 'nav.projects'), key: 'projects' },
  { href: localePath('/publications', lang), label: t(lang, 'nav.pubs'), key: 'pubs' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {/* Масштабирование не запрещаем: двойной тап-зум и так снят через touch-action,
        а user-scalable=no отбирает у людей возможность увеличить мелкий текст. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    {/* Соединение с чужими хостами картинок стоит DNS + TLS — начинаем его
        параллельно с разбором HTML, а не в момент встречи <img>. */}
    {preconnect.map((origin) => <link rel="preconnect" href={origin} crossorigin />)}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {/* Каноникал и hreflang: у русской и английской версии разные URL, но одна страница */}
    <link rel="canonical" href={canonical} />
    {langLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {config.googleSiteVerification && (
      <meta name="google-site-verification" content={config.googleSiteVerification} />
    )}
    {config.yandexVerification && <meta name="yandex-verification" content={config.yandexVerification} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="NORMno" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {langLinks
      .filter((alt) => alt.hreflang !== lang && alt.hreflang !== 'x-default')
      .map((alt) => <meta property="og:locale:alternate" content={ogLocale(alt.hreflang as Lang)} />)}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(lang, 'pubs.rssTitle')}
      href={localePath('/rss.xml', lang)}
    />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    {jsonLd.map((node) => <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </head>
  <body>
    <div class="page">
      <div class="blobs" aria-hidden="true">
        <div class="blob blob-a" style="left:-8%;top:-12%;width:46vw;height:46vw;"></div>
        <div class="blob blob-b" style="left:58%;top:4%;width:40vw;height:40vw;"></div>
        <div class="blob blob-c" style="left:22%;top:55%;width:44vw;height:44vw;"></div>
      </div>

      {
        !hideNav && (
          <div class="nav-wrap">
            <nav class="glass">
              <button id="brand-smile" class="brand" type="button" aria-label={siteHost} title={siteHost}>
                {/* Фирменный смайл (Figma L8ByEhwaRWe2B7Hnpd16AD, Group 1): глаза «((» и улыбка */}
                <svg viewBox="0 0 65 78" width="26" height="31" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" aria-hidden="true">
                  <path class="smile-eye" d="M21 4 C 14.5 19, 14.5 35, 21 48" />
                  <path class="smile-eye" d="M47.5 4 C 40 19, 40 35, 47.5 48" />
                  <path class="smile-mouth" d="M3 65 C 20 76.5, 46 76.5, 62 64" />
                </svg>
              </button>
              {nav.map((item) => (
                <a href={item.href} class:list={['nav-link', { active: active === item.key }]} data-ripple>
                  {item.label}
                </a>
              ))}
            </nav>
          </div>
        )
      }

      {!hideNav && suggestLang && <LangHint target={suggestLang} path={path} />}

      <slot />

      {
        showTranslationNote && (
          <p class="mt-note">
            <span aria-hidden="true">✨</span> {t(lang, 'lang.machineNote')}
          </p>
        )
      }
    </div>

    {!hideNav && <LangSwitcher lang={lang} path={path} />}

    {/* WebMCP: инструменты страницы для ИИ-агентов. Файл грузится только там, где
        браузер действительно даёт этот API, — обычному посетителю он не стоит ни байта. */}
    <script is:inline type="module">
      if (navigator.modelContext || document.modelContext) import('/webmcp.js');
    </script>

    <script>
      // Ripple-эффект (делегирование) — единственный глобальный JS на публичных страницах.
      document.addEventListener('click', (e) => {
        const target = (e.target as Element | null)?.closest?.('[data-ripple]') as HTMLElement | null;
        if (!target) return;
        const rect = target.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height) * 2;
        const ink = document.createElement('span');
        ink.className = 'ripple-ink';
        ink.style.width = ink.style.height = `${size}px`;
        ink.style.left = `${e.clientX - rect.left - size / 2}px`;
        ink.style.top = `${e.clientY - rect.top - size / 2}px`;
        target.appendChild(ink);
        setTimeout(() => ink.remove(), 650);
      });

      // Пасхалка: клик по смайлу — моргание.
      const smile = document.getElementById('brand-smile');
      smile?.addEventListener('click', () => {
        smile.classList.remove('blinking');
        // reflow, чтобы анимация перезапускалась при повторных кликах
        void smile.offsetWidth;
        smile.classList.add('blinking');
        setTimeout(() => smile.classList.remove('blinking'), 1300);
      });
    </script>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    position: relative;
    /* Именно clip, а не hidden: hidden по одной оси заставляет браузер сделать
       вторую ось прокручиваемой, и .page превращается во вложенный скролл-контейнер.
       На тач-экранах он съедает свайп при смене направления — страница
       «залипает», как будто кончилась. Горизонтально страницу всё равно
       обрезает body (overflow-x: hidden в global.css). */
    overflow-x: clip;
  }
  .blobs {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .blob-a {
    background: var(--blob-a);
  }
  .blob-b {
    background: var(--blob-b);
  }
  .blob-c {
    background: var(--blob-c);
  }

  /* Движущийся размытый фон под «стеклом» заставляет браузер пересчитывать
     backdrop-filter каждый кадр — на телефоне это самая дорогая анимация на
     странице. Оставляем её там, где она бесплатна: широкий экран, мышь,
     и посетитель не просил убрать анимации. */
  @media (min-width: 900px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .blob {
      will-change: transform;
    }
    .blob-a,
    .blob-c {
      animation: blobA 14s ease-in-out infinite;
    }
    .blob-b {
      animation: blobB 14s ease-in-out infinite;
    }
  }

  .nav-wrap {
    position: sticky;
    top: 10px;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0 12px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2px;
    padding: 8px 10px;
    border-radius: 28px;
    background: var(--glass-07);
    border: 1px solid var(--line-14);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 var(--inset-top);
  }
  .brand {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5px clamp(9px, 2.6vw, 14px);
    border-radius: 20px;
    border: none;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .brand svg {
    display: block;
  }
  .smile-eye {
    transform-origin: 50% 26px;
    transform-box: view-box;
  }
  .brand.blinking .smile-eye {
    animation: smileBlink 1.2s ease-in-out;
  }
  .nav-link {
    font-size: clamp(12.5px, 3.3vw, 14px);
    white-space: nowrap;
    padding: 8px clamp(9px, 2.6vw, 16px);
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.3s;
    position: relative;
    overflow: hidden;
  }
  .nav-link:hover {
    background: var(--glass-08);
  }
  .nav-link.active {
    background: var(--active);
  }

  /* Сноска о машинном переводе — тихая строка внизу переведённой страницы.
     Без отрицательных отступов: они наезжали на нижнюю часть main и меняли
     высоту страницы только в английской версии. */
  .mt-note {
    position: relative;
    z-index: 1;
    margin: 0 auto 40px;
    padding: 0 clamp(14px, 4vw, 24px);
    max-width: 1060px;
    font-size: 12px;
    /* Не --fg-45: на светлой теме мелкий текст этим цветом не добирает
       контраст 4.5:1, которого требует WCAG AA. */
    color: var(--fg-60);
    text-align: center;
  }
</style>
