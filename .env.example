# --- Домены ---
# Публичный адрес сайта
SITE_URL=https://normno.ru
# Домены для Caddy (docker-compose)
SITE_DOMAIN=normno.ru
ADMIN_DOMAIN=admin.normno.ru
# Дополнительные домены сайта через пробел (например «normno.com www.normno.com»).
# Caddy выпустит на каждый сертификат Let's Encrypt и отдаст 301 на SITE_DOMAIN.
# A-записи этих доменов должны указывать на сервер ДО перезапуска.
ALIAS_DOMAINS=
# Хост, с которого доступна админка. На всех остальных хостах /admin отдаёт 404.
# Для локальной разработки оставьте admin.localhost (http://admin.localhost:4321/admin)
ADMIN_HOST=admin.normno.ru

# --- Админка (Basic Auth) ---
ADMIN_USER=admin
ADMIN_PASS=

# --- GitHub ---
# Пользователь, чьи репозитории показываем
GITHUB_USERNAME=NORMss
# Personal access token (classic, scope public_repo достаточно) — повышает лимиты API
GITHUB_TOKEN=

# --- Spotify (виджет «сейчас играет») ---
# https://developer.spotify.com/dashboard → создать приложение и добавить
# Redirect URI https://<ADMIN_DOMAIN>/admin/spotify/callback,
# затем нажать «Подключить Spotify» в админке (токен сохранится в БД).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Необязательно: токен, полученный вручную (имеет приоритет над админкой)
SPOTIFY_REFRESH_TOKEN=
# Необязательно: переопределить redirect URI (для локальной разработки)
SPOTIFY_REDIRECT_URI=

# --- Telegram (импорт постов канала + публикация постов сайта в канал) ---
# Подробная инструкция: docs/TELEGRAM.md
# Токен бота от @BotFather; бот должен быть администратором канала
# (для публикации с сайта — с правом «Post messages»)
TELEGRAM_BOT_TOKEN=
# @username канала (или -100… для приватного). Нужен для отправки постов
# в канал; при импорте служит фильтром «только этот канал»
TELEGRAM_CHANNEL=
# ЛИЧНЫЙ chat_id для ежедневных бэкапов БД и загруженных файлов (НЕ канал!).
# Узнать свой id: @userinfobot. Пусто — бэкапы выключены.
TELEGRAM_BACKUP_CHAT_ID=

# --- Прочее ---
DB_PATH=/app/data/site.db
SYNC_INTERVAL_MIN=30
# Часовой пояс контейнера: от него зависит время ежедневного бэкапа (04:30)
TZ=UTC
