# --- Домены ---
# Все адреса ниже — примеры. Впишите свои: реальные домены должны жить
# только в .env на сервере, а не в репозитории.
# Публичный адрес сайта
SITE_URL=https://example.com
# Домены для Caddy (docker-compose)
SITE_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
# Дополнительные домены сайта через пробел (например «example.ru www.example.com»).
# Caddy выпустит на каждый сертификат Let's Encrypt и отдаст 301 на основной.
# A-записи этих доменов должны указывать на сервер ДО перезапуска.
ALIAS_DOMAINS=example.ru
# Хост, с которого доступна админка. На всех остальных хостах /admin отдаёт 404.
# Для локальной разработки оставьте admin.localhost (http://admin.localhost:4321/admin)
ADMIN_HOST=admin.example.com

# --- Админка (Basic Auth) ---
# Имя админа: задайте своё, «admin» угадывается перебором первым. Пусто — admin.
ADMIN_USER=
# Длинный случайный пароль: `openssl rand -base64 32`. Имя админ-поддомена
# публично (сертификат Let's Encrypt виден в Certificate Transparency),
# поэтому вся защита админки держится на этом пароле.
ADMIN_PASS=

# --- GitHub ---
# Пользователь, чьи репозитории показываем
GITHUB_USERNAME=NORMss
# Personal access token (classic, scope public_repo достаточно) — повышает лимиты API
GITHUB_TOKEN=

# --- Spotify (виджет «сейчас играет») ---
# https://developer.spotify.com/dashboard → создать приложение и добавить
# Redirect URI https://<ADMIN_DOMAIN>/admin/spotify/callback,
# затем нажать «Подключить Spotify» в админке (токен сохранится в БД).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Необязательно: токен, полученный вручную (имеет приоритет над админкой)
SPOTIFY_REFRESH_TOKEN=
# Необязательно: переопределить redirect URI (для локальной разработки)
SPOTIFY_REDIRECT_URI=

# --- Telegram (импорт постов канала + публикация постов сайта в канал) ---
# Подробная инструкция: docs/TELEGRAM.md
# Токен бота от @BotFather; бот должен быть администратором канала
# (для публикации с сайта — с правом «Post messages»)
TELEGRAM_BOT_TOKEN=
# @username канала (или -100… для приватного). Нужен для отправки постов
# в канал; при импорте служит фильтром «только этот канал»
TELEGRAM_CHANNEL=
# ЛИЧНЫЙ chat_id для ежедневных бэкапов БД и загруженных файлов (НЕ канал!).
# Узнать свой id: @userinfobot. Пусто — бэкапы выключены.
TELEGRAM_BACKUP_CHAT_ID=

# --- Автоперевод на английский ---
# Подробности и сравнение тарифов: docs/TRANSLATE.md
# Какой провайдер использовать: google | deepl | azure | none.
# Пусто — берётся первый, для которого задан ключ (google → deepl → azure).
TRANSLATE_PROVIDER=google
# Google Cloud Translation API v2, авторизация обычным API-ключом.
# console.cloud.google.com → включить Cloud Translation API → Credentials → API key
# (ключ желательно ограничить по API «Cloud Translation API»).
# Бесплатно 500 000 символов в месяц, дальше $20 за миллион.
GOOGLE_TRANSLATE_API_KEY=
# Альтернатива 1: DeepL API Free — 500 000 символов/мес, показывает реальный расход
DEEPL_API_KEY=
# Альтернатива 2: Azure AI Translator, тариф F0 — 2 000 000 символов/мес бесплатно
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Свой месячный потолок символов (0 или пусто — бесплатный лимит провайдера).
# Сервер сам перестаёт переводить при достижении потолка, деньги не списываются.
TRANSLATE_MONTHLY_LIMIT=

# --- SEO ---
# Ключ IndexNow (любая строка из 8–128 hex-символов): сайт сам уведомляет
# Bing и Яндекс о новых постах. Файл-подтверждение отдаётся по /<ключ>.txt.
INDEXNOW_KEY=
# content= из мета-тега подтверждения прав в Google Search Console
GOOGLE_SITE_VERIFICATION=
# content= из мета-тега подтверждения прав в Яндекс.Вебмастере
YANDEX_VERIFICATION=

# --- Прочее ---
DB_PATH=/app/data/site.db
SYNC_INTERVAL_MIN=30
# Часовой пояс контейнера: от него зависит время ежедневного бэкапа (04:30).
# Укажите свой, например Europe/Berlin.
TZ=UTC
